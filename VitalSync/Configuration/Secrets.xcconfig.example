// Copy this file to Secrets.xcconfig for local use. Never commit that copy.
// The Oura client ID and broker URL are public configuration, not secrets.
OURA_CLIENT_ID = YOUR_OURA_CLIENT_ID
TOKEN_BROKER_BASE_URL = https:/$()/YOUR_BROKER.workers.dev

// Never put OURA_CLIENT_SECRET here. Store it only in the broker's secret store.
