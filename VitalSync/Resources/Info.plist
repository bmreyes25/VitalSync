<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDisplayName</key>
    <string>VitalSync</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleName</key>
    <string>$(PRODUCT_NAME)</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>0.1.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>OuraClientID</key>
    <string>$(OURA_CLIENT_ID)</string>
    <key>TokenBrokerBaseURL</key>
    <string>$(TOKEN_BROKER_BASE_URL)</string>
    <key>LSRequiresIPhoneOS</key>
    <true/>
    <key>NSHealthShareUsageDescription</key>
    <string>VitalSync reads your authorized Health data only to reconcile imports and prevent duplicates.</string>
    <key>NSHealthUpdateUsageDescription</key>
    <string>VitalSync writes only compatible Oura measurements you explicitly choose to Apple Health.</string>
    <key>BGTaskSchedulerPermittedIdentifiers</key>
    <array>
        <string>com.example.VitalSync.refresh</string>
    </array>
    <key>UIBackgroundModes</key>
    <array>
        <string>processing</string>
    </array>
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleTypeRole</key>
            <string>Editor</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>vitalsync</string>
            </array>
        </dict>
    </array>
</dict>
</plist>
